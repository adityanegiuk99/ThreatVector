# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veylix
POSTGRES_USER=veylix
POSTGRES_PASSWORD=veylix_dev_password

# --- API ---
VEYLIX_ENV=dev
VEYLIX_API_HOST=0.0.0.0
VEYLIX_API_PORT=8000
VEYLIX_LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
VEYLIX_SECRET_KEY=change-me-in-prod
VEYLIX_SIGNING_KEY=change-me-in-prod

# --- LLM Provider (optional; core works without a key) ---
# Supported providers: anthropic | openai | none
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# --- Retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ingestion ---
veylix_NVD_API_KEY=
veylix_REQUEST_TIMEOUT=30
veylix_MAX_RETRIES=3
